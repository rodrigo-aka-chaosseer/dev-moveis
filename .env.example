# Valores públicos do Dashboard > Project Settings > API.
# Nunca use service_role, senha do banco ou chave da IA no aplicativo.
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_SUA_CHAVE_PUBLICA

# Opcional: força o gerador local mesmo com Supabase configurado.
# Sem Supabase, o modo demonstração já é ativado automaticamente.
EXPO_PUBLIC_MODO_IA_DEMO=false

# Configure no .env.local ou no ambiente de build; nunca versione o valor.
GOOGLE_MAPS_ANDROID_API_KEY=
